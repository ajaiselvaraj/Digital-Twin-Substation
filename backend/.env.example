# Server Configuration
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=*

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=oceanberg-digital-twin

# Firebase Configuration
# Path to service account JSON file, e.g. ./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=
# Or copy-paste the contents of service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_DATABASE_URL=https://oceanberg-digitaltwin-default-rtdb.asia-southeast1.firebasedatabase.app

# ML Microservice URL
ML_SERVICE_URL=http://localhost:8000
ML_PREDICT_TIMEOUT_MS=15000

# SMTP Mail Server (Alert Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Digital Twin Substation <your_email@gmail.com>"
